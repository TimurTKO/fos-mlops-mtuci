# Имя и тег локального образа, который запускает Compose.
API_IMAGE=mlops-course-api
API_TAG=stable
API_PORT=8000

# Ожидаемая версия нужна smoke-тесту и менеджеру выпуска.
EXPECTED_SERVICE_VERSION=1.0.0
RELEASE_CHANNEL=stable

# Используется только для учебного моделирования неуспешного выпуска.
SIMULATE_STARTUP_FAILURE=0

# Аргументы сборки при прямом `docker compose build`.
BUILD_SERVICE_VERSION=1.0.0
BUILD_MODEL_VERSION=baseline-v1
BUILD_MODEL_C=1.0
BUILD_MODEL_RANDOM_STATE=42

# Локальные порты мониторинга.
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
# Заменить в локальном .env; не использовать это значение вне учебного компьютера.
GRAFANA_ADMIN_PASSWORD=change-me-locally
